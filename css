/* ==========================================================================
   RESET & FOUNDATION SETTINGS
   ========================================================================== */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #0b0b0b;
    color: #ffffff;
    padding: 20px;
    display: flex;
    justify-content: center;
}

/* Outer Graphic Frame (Neon Border Accent from Image) */
.web-frame {
    width: 100%;
    max-width: 1200px;
    border: 4px solid #39ff14; /* Toxic Bright Green Frame border */
    padding: 15px;
    background-color: #121212;
    border-radius: 8px;
    box-shadow: 0 0 20px rgba(57, 255, 20, 0.2);
}

/* ==========================================================================
   TOP BLOCK HEADER SYSTEM
   ========================================================================== */
.header-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 15px;
    margin-bottom: 40px;
}

.header-box {
    border: 3px solid #ff0000; /* Distinct red borders */
    border-radius: 12px;
    padding: 15px;
    background-color: #1a0000;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
}

.nav-welcome h2 {
    color: #ff0055;
    font-style: italic;
    font-size: 1.4rem;
}

.nav-welcome p {
    color: #fff;
    font-weight: bold;
    margin-top: 5px;
}

.nav-menu a {
    color: #ffffff;
    text-decoration: none;
    font-size: 1.2rem;
    margin: 5px 0;
    font-weight: 500;
    transition: color 0.2s ease;
}

.nav-menu a:hover {
    color: #39ff14;
}

.nav-contact p {
    font-size: 0.95rem;
    margin: 3px 0;
}

.nav-contact a {
    color: #39ff14;
    text-decoration: none;
}

.highlight-text {
    color: #ffcc00;
    font-style: italic;
}

/* ==========================================================================
   HERO CONTAINER (OFFERS + REGISTRATION FORM)
   ========================================================================== */
.hero-section {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    align-items: center;
    gap: 30px;
    margin-bottom: 40px;
    padding: 20px 0;
}

/* Exciting Offers Circle Component */
.offer-circle {
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, #005f73 0%, #001219 100%);
    border: 5px dashed #ffb703;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 25px;
    text-align: center;
    box-shadow: 0 0 15px rgba(255, 183, 3, 0.4);
}

.offer-content h3 {
    color: #39ff14;
    font-size: 1.3rem;
    letter-spacing: 2px;
    text-decoration: underline;
}

.offer-content hr {
    margin: 15px 0;
    border: 0;
    height: 1px;
    background: #ffb703;
}

.offer-content p {
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: bold;
    line-height: 1.4;
}

/* Red-dashed Registration Form Component */
.registration-card {
    width: 100%;
    max-width: 450px;
    border: 3px dashed #ff0000;
    background-color: rgba(0, 0, 0, 0.7);
    padding: 25px;
    border-radius: 8px;
}

.registration-card h3 {
    color: #ff3333;
    text-align: center;
    margin-bottom: 20px;
    letter-spacing: 1px;
    font-size: 1.2rem;
}

.form-group {
    margin-bottom: 15px;
    display: flex;
    flex-direction: column;
}

.form-group label {
    font-size: 0.85rem;
    color: #ff4444;
    margin-bottom: 4px;
    font-weight: bold;
}

.form-group input[type="text"],
.form-group input[type="number"],
.form-group input[type="email"],
.form-group input[type="date"] {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid #555;
    background-color: #ffffff;
    color: #000000;
    border-radius: 4px;
    font-size: 0.9rem;
}

.checkbox-group {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background: rgba(255,255,255,0.05);
    padding: 8px;
    border-radius: 4px;
}

.checkbox-group label {
    margin-bottom: 0;
    color: #ff9999;
}

.checkbox-group input {
    width: 18px;
    height: 18px;
    cursor: pointer;
}

/* Form Action Control Buttons */
.form-actions {
    display: flex;
    gap: 15px;
    margin-top: 20px;
}

.form-actions button {
    flex: 1;
    padding: 10px;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    cursor: pointer;
    font-size: 0.9rem;
    transition: opacity 0.2s;
}

.form-actions button:hover {
    opacity: 0.9;
}

.btn-submit {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #000;
}

.btn-reset {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #000;
}

/* ==========================================================================
   MENU SECTION BREAK HEADER BANNER
   ========================================================================== */
.menu-divider-banner {
    background-color: #000000;
    border: 3px solid #ffffff;
    border-radius: 25px;
    text-align: center;
    padding: 12px;
    margin: 40px auto;
    width: 90%;
    max-width: 600px;
    box-shadow: 0 0 10px rgba(255,255,255,0.1);
}

.menu-divider-banner h1 {
    color: #ffffff;
    letter-spacing: 8px;
    font-size: 2rem;
    font-weight: bold;
}

/* ==========================================================================
   3-COLUMN MENU RESPONSIVE GRID
   ========================================================================== */
.menu-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 25px;
    padding: 10px;
}

.menu-column {
    background-color: #00d2ff; /* Default Cyan fallback styling matching screenshot panels */
    color: #000000;
    border-radius: 20px;
    padding: 20px 25px;
    box-shadow: 0 6px 12px rgba(0,0,0,0.3);
}

/* Alternating/Specific Theme Colors matching UI Panels */
.menu-column.starters, 
.menu-column.south-indian, 
.menu-column.indian-kitchen {
    background-color: #00d2ff; /* Upper Cyan blocks */
}

.menu-column.rice-salad, 
.menu-column.tandoori-bread, 
.menu-column.beverages {
    background-color: #00d2ff; /* Lower Cyan blocks */
}

.menu-column h3 {
    text-align: center;
    font-size: 1.6rem;
    margin-bottom: 15px;
    font-weight: 800;
    border-bottom: 2px solid rgba(0, 0, 0, 0.15);
    padding-bottom: 8px;
}

.menu-column ul {
    list-style-type: none;
}

.menu-column ul li {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 8px;
    padding-left: 15px;
    position: relative;
}

/* Circular dot pseudo element markers mirroring image layout lists */
.menu-column ul li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #000000;
    font-size: 1.2rem;
}

/* ==========================================================================
   MOBILE RESPONSIVENESS OVERRIDES
   ========================================================================== */
@media (max-width: 768px) {
    .hero-section {
        flex-direction: column;
    }
    .offer-circle {
        width: 280px;
        height: 280px;
    }
    .menu-divider-banner h1 {
        font-size: 1.6rem;
        letter-spacing: 4px;
    }
}
