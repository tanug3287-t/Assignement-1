<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dhaba Tha - Menu & Registration</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="web-frame">
        <!-- TOP HEADER AREA -->
        <header class="header-grid">
            <div class="header-box nav-welcome">
                <h2>Welcome to Dhaba tha</h2>
                <p>You get quality perfect</p>
            </div>
            <div class="header-box nav-menu">
                <a href="#">Home Menu review</a>
                <a href="#">contact us</a>
            </div>
            <div class="header-box nav-contact">
                <p>Email: <a href="mailto:sadwanr@gmail.com">sadwanr@gmail.com</a></p>
                <p class="highlight-text">If you find any complain</p>
                <p>Contact no: 8709451380</p>
            </div>
        </header>

        <!-- MIDDLE WRAPPER (Offers + Registration) -->
        <main class="hero-section">
            
            <!-- Exciting Offers Badge -->
            <div class="offer-circle">
                <div class="offer-content">
                    <h3>EXCITING OFFERS</h3>
                    <hr>
                    <p>**GET OUR SPECIAL THALI FOR ONLY RS 100 ON MONDAY**</p>
                </div>
            </div>

            <!-- Registration Form Block -->
            <div class="registration-card">
                <h3>PLEASE REGISTER HERE</h3>
                <form action="#" method="POST">
                    <div class="form-group">
                        <label>First Name:</label>
                        <input type="text" placeholder="Enter Your First Name" required>
                    </div>
                    <div class="form-group">
                        <label>Last Name:</label>
                        <input type="text" placeholder="Enter Your Last Name" required>
                    </div>
                    <div class="form-group">
                        <label>Your Age:</label>
                        <input type="number" placeholder="Enter Your age" required>
                    </div>
                    <div class="form-group">
                        <label>Email:</label>
                        <input type="email" placeholder="My Email" required>
                    </div>
                    <div class="form-group">
                        <label>Date of Birth:</label>
                        <input type="date" required>
                    </div>
                    
                    <div class="form-group checkbox-group">
                        <label>Are You more than one person?</label>
                        <input type="checkbox">
                    </div>
                    <div class="form-group checkbox-group">
                        <label>Do You have cough or cold?</label>
                        <input type="checkbox">
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-submit">Submit Here</button>
                        <button type="reset" class="btn-reset">Reset</button>
                    </div>
                </form>
            </div>
        </main>

        <!-- MENU TITLE HEADER -->
        <div class="menu-divider-banner">
            <h1>MENU</h1>
        </div>

        <!-- 3-COLUMN MENU ITEMS GRID -->
        <section class="menu-container">
            <!-- Row 1 -->
            <div class="menu-column starters">
                <h3>Starters</h3>
                <ul>
                    <li>Paneer Tikka</li>
                    <li>Tomato Soup</li>
                    <li>Afghani Chaap</li>
                    <li>Gol Gappa</li>
                    <li>Tikki</li>
                    <li>Fried Rice</li>
                </ul>
            </div>

            <div class="menu-column south-indian">
                <h3>South Indian</h3>
                <ul>
                    <li>Masala Dosa</li>
                    <li>Idli Sambhar</li>
                    <li>Mix Veg. Uttapam</li>
                    <li>Onion Dosa</li>
                    <li>Vada Sambhar</li>
                    <li>Paper Plain Dosa</li>
                    <li>Tomato Uttapam</li>
                </ul>
            </div>

            <div class="menu-column indian-kitchen">
                <h3>Indian Kitchen</h3>
                <ul>
                    <li>Shahi Paneer</li>
                    <li>Kadhai Panner</li>
                    <li>Aloo Gobhi</li>
                    <li>Dal Makhni</li>
                    <li>Poori Sabji</li>
                    <li>Malai Kofta</li>
                    <li>Stuff Capsicum</li>
                </ul>
            </div>

            <!-- Row 2 -->
            <div class="menu-column rice-salad">
                <h3>Rice & Salad</h3>
                <ul>
                    <li>Plain Rice</li>
                    <li>Jeera Rice</li>
                    <li>Fried Rice</li>
                    <li>Veg Pulao</li>
                    <li>Veg Biryani</li>
                    <li>Cheese Biryani</li>
                </ul>
            </div>

            <div class="menu-column tandoori-bread">
                <h3>Tandoori Bread</h3>
                <ul>
                    <li>Butter Roti</li>
                    <li>Missi Roti</li>
                    <li>Onion Parantha</li>
                    <li>Lacha Parantha</li>
                    <li>Butter Naan</li>
                    <li>Paneer Naan</li>
                </ul>
            </div>

            <div class="menu-column beverages">
                <h3>Beverages And Other</h3>
                <ul>
                    <li>Cold Coffee</li>
                    <li>Cold Drinks</li>
                    <li>Badam Milk</li>
                    <li>Ice Cream</li>
                </ul>
            </div>
        </section>
    </div>

</body>
</html>
